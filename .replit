entrypoint = "server.js"
modules = ["nodejs-20:v8-20230920-bd784b9"]
run = "npm start"

[nix]
channel = "stable-24_05"

[deployment]
build = ["sh", "-c", "npm install"]
run = ["sh", "-c", "npm start"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5057
externalPort = 3000
